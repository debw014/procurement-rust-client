{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清单制作工具",
  "version": "1.0.0",
  "identifier": "com.procurement.listtool",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "清单制作工具",
        "width": 1220,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
